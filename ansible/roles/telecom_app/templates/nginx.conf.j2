upstream telecom_backend {
    server 127.0.0.1:{{ app_port }};
    keepalive 32;
}

server {
    listen {{ nginx_port }} default_server;
    listen [::]:{{ nginx_port }} default_server;
    server_name _;

    client_max_body_size 16M;

    access_log /var/log/nginx/telecom_access.log;
    error_log /var/log/nginx/telecom_error.log warn;

    location / {
        proxy_pass http://telecom_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Direct Health Check Route
    location /health {
        proxy_pass http://telecom_backend/api/health;
        access_log off;
    }
}
